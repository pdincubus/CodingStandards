{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "strict": true,
        "jsx": "react-jsx",
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "useUnknownInCatchVariables": true,
        "exactOptionalPropertyTypes": true,
        "skipLibCheck": true
    },
    "include": [
        "./**/*.ts",
        "./**/*.tsx"
    ]
}